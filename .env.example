# Base de datos (Supabase / Neon en producción; local en desarrollo)
DATABASE_URL="postgresql://user:password@localhost:5432/graficopias"

# NextAuth (Admin)
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del Admin (única cuenta, sin tabla de usuarios en v1)
# IMPORTANTE: escapar cada "$" del hash bcrypt como "\$" — Next.js expande
# variables tipo $VAR dentro de los .env y si no se escapa rompe el hash.
ADMIN_EMAIL="admin@graficopias.com.ar"
ADMIN_PASSWORD_HASH="generar-con-bcrypt-hash-de-la-contraseña-escapando-los-\$"

# Mercado Pago (credenciales de test para desarrollo)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Notificación de pedido nuevo (Resend)
RESEND_API_KEY=""
NOTIFY_EMAIL_TO="graficopias.10@gmail.com"
NOTIFY_EMAIL_FROM=""

# URL pública del sitio (usada para construir back_urls de Mercado Pago)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
